# Copy this file to deploy/production/backend.env on the server.
# Never commit the resulting backend.env file.

APP_ENV=production
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2
GIGACHAT_CA_BUNDLE_FILE=certs/russian_trusted_root_ca_pem.crt

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

# Exact browser origins, comma-separated. Capacitor uses https://localhost.
API_CORS_ORIGINS=https://your-cloudflare-frontend.example.workers.dev,https://athena-ai-blond.vercel.app,https://localhost

TRACE_CONTENT_MODE=off
TRACE_RAW_PAYLOAD_RETENTION_DAYS=7
TRACE_RECORD_RETENTION_DAYS=90
TRACE_PAYLOAD_MAX_CHARS=4000
TRACE_PAYLOAD_MAX_COLLECTION_ITEMS=100
TRACE_EXPORT_MAX_RUNS=1000

AGENT_JOB_QUEUE=athena-agent
AGENT_JOB_TTL_SECONDS=3600

LLM_ROUTER_MODEL=
LLM_MODEL_ROUTING_ENABLED=true
LLM_MODEL_ROUTING_POLICY={"router.route_classification":"small","nutrition.food_translation":"small","*":"main"}
AGENT_BASELINE_VERSION=baseline-v1

SAFE_RETRY_MAX_ATTEMPTS=3
SAFE_RETRY_BASE_DELAY_SECONDS=0.5
SAFE_RETRY_MAX_DELAY_SECONDS=4.0
SAFE_RETRY_JITTER_RATIO=0.25
SAFE_RETRY_RATE_LIMIT_MAX_ATTEMPTS=4
SAFE_RETRY_RATE_LIMIT_BASE_DELAY_SECONDS=2.0
SAFE_RETRY_RATE_LIMIT_MAX_DELAY_SECONDS=30.0

LLM_RATE_LIMITER_ENABLED=true
LLM_RATE_LIMIT_REQUESTS_PER_SECOND=4.0
LLM_RATE_LIMIT_BURST=4
LLM_RATE_LIMIT_ACQUIRE_TIMEOUT_SECONDS=30.0
LLM_RATE_LIMIT_STATE_TTL_SECONDS=3600

LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
LLM_CIRCUIT_BREAKER_HALF_OPEN_LEASE_SECONDS=210
LLM_CIRCUIT_BREAKER_STATE_TTL_SECONDS=3600

AGENT_MEMORY_UPDATES_ENABLED=true
AGENT_MEMORY_RECENT_MESSAGE_LIMIT=8
AGENT_MEMORY_CONFIDENCE_THRESHOLD=0.9
AGENT_MEMORY_MAX_ITEMS_PER_CATEGORY=40
AGENT_MEMORY_SUMMARY_MAX_CHARS=1200

RAG_ENABLED=true
RAG_RETRIEVAL_LIMIT=6
RAG_MIN_SIMILARITY=0.55
RAG_CONTEXT_MAX_CHARS=12000
