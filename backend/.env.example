LLM_PROVIDER=gigachat
# Explicit local/test mode. It never calls GigaChat and does not bypass JWT.
MOCK_LLM_MODEL=athena-mock-v1
MOCK_LLM_LATENCY_MS=0
# Capacity-test mode: keep FastAPI/Redis/Celery, skip LangGraph and Supabase.
# Safe only together with LLM_PROVIDER=mock.
AGENT_INFRASTRUCTURE_TEST_MODE=false
AGENT_INFRASTRUCTURE_TEST_LATENCY_MS=0

LLM_ROUTER_MODEL=
LLM_MODEL_ROUTING_ENABLED=true
# Priority: exact node.purpose, node.*, *.purpose, then *.
LLM_MODEL_ROUTING_POLICY={"router.route_classification":"small","nutrition.food_translation":"small","*":"main"}
AGENT_BASELINE_VERSION=baseline-v1

GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat-2

# Idempotent LLM/read retries: 0.5s, 1s, ... plus up to 25% jitter.
SAFE_RETRY_MAX_ATTEMPTS=3
SAFE_RETRY_BASE_DELAY_SECONDS=0.5
SAFE_RETRY_MAX_DELAY_SECONDS=4.0
SAFE_RETRY_JITTER_RATIO=0.25
# HTTP 429 uses a calmer independent schedule: 2s, 4s, 8s.
SAFE_RETRY_RATE_LIMIT_MAX_ATTEMPTS=4
SAFE_RETRY_RATE_LIMIT_BASE_DELAY_SECONDS=2.0
SAFE_RETRY_RATE_LIMIT_MAX_DELAY_SECONDS=30.0

# Shared Redis token bucket applied before every actual GigaChat attempt.
# Tune the rate and burst to the quota of your GigaChat contract.
LLM_RATE_LIMITER_ENABLED=true
LLM_RATE_LIMIT_REQUESTS_PER_SECOND=4.0
LLM_RATE_LIMIT_BURST=4
LLM_RATE_LIMIT_ACQUIRE_TIMEOUT_SECONDS=30.0
LLM_RATE_LIMIT_STATE_TTL_SECONDS=3600

# Shared Redis circuit breaker for GigaChat calls.
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
LLM_CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30
# Must cover the longest provider call, including retries and backoff.
LLM_CIRCUIT_BREAKER_HALF_OPEN_LEASE_SECONDS=210
LLM_CIRCUIT_BREAKER_STATE_TTL_SECONDS=3600

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only required for projects that still issue legacy HS256 access tokens.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

APP_ENV=dev
API_CORS_ORIGINS=http://localhost:5175,http://127.0.0.1:5175

# Trace payload lifecycle: redaction -> retention -> export -> deletion.
# auto: development=full, staging=sampled_redacted, production=structured_only.
TRACE_PAYLOAD_POLICY=auto
TRACE_PAYLOAD_SAMPLE_RATE=0.1
TRACE_RAW_PAYLOAD_RETENTION_DAYS=7
TRACE_RECORD_RETENTION_DAYS=90
TRACE_PAYLOAD_MAX_CHARS=4000
TRACE_PAYLOAD_MAX_COLLECTION_ITEMS=100
TRACE_EXPORT_MAX_RUNS=1000

# Redis is the Celery broker and the short-lived job-status store.
REDIS_URL=redis://127.0.0.1:6379/0
AGENT_JOB_QUEUE=athena-agent
AGENT_JOB_TTL_SECONDS=3600

# Layered conversation memory (recent turns + summary + durable facts + state)
AGENT_MEMORY_UPDATES_ENABLED=true
AGENT_MEMORY_RECENT_MESSAGE_LIMIT=8
AGENT_MEMORY_CONFIDENCE_THRESHOLD=0.9
AGENT_MEMORY_MAX_ITEMS_PER_CATEGORY=40
AGENT_MEMORY_SUMMARY_MAX_CHARS=1200

RAG_ENABLED=true
RAG_RETRIEVAL_LIMIT=6
RAG_MIN_SIMILARITY=0.55
RAG_CONTEXT_MAX_CHARS=12000
