{
  "name": "food_nutrients",
  "type": "object",
  "properties": {
    "food_name": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "protein",
        "carb",
        "fat",
        "fiber",
        "mixed"
      ]
    },
    "calories_per_100g": {
      "type": "number"
    },
    "protein_g": {
      "type": "number"
    },
    "carbs_g": {
      "type": "number"
    },
    "fat_g": {
      "type": "number"
    },
    "fiber_g": {
      "type": "number"
    },
    "sugar_g": {
      "type": "number"
    },
    "sodium_mg": {
      "type": "number"
    },
    "glycemic_index": {
      "type": "number"
    },
    "micronutrients": {
      "type": "object",
      "properties": {
        "iron": {
          "type": "number"
        },
        "calcium": {
          "type": "number"
        },
        "vitamin_c": {
          "type": "number"
        }
      }
    },
    "health_tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "food_name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": null,
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}